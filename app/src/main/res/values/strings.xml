    <string name="about_title">Phone %1$s</string>
    <string name="about_what">Calls, recent calls and the people to call. The app has no internet permission.</string>
    <string name="about_privacy_heading">Privacy</string>
    <string name="about_privacy">Everything you put in this app stays on this phone. It has no internet access, so nothing is sent anywhere, and nothing is collected about you.\n\nIt reads your contacts to put names to numbers and list favourites. It reads your call log to list recent calls, and changes it only to delete a call, clear the list or mark missed calls seen. It reads the phone state for the names of your SIMs, your voicemail number and whether a voicemail is waiting. Numbers you block go into the phone\'s own blocked-numbers list; a record of the calls it turned away (time, number and rule) is kept on this phone for 30 days.\n\nThere are no ads, no analytics and no tracking. Backups and exports go only where you choose to save them.</string>
    <string name="about_terms_heading">Terms</string>
    <string name="about_terms">This app is free software under the GNU General Public License v3. It comes with no warranty: use it at your own risk.</string>
    <string name="about_made_heading">Made from</string>
    <string name="about_licence">GNU General Public License v3</string>
    <string name="about_base">Fossify Phone and Fossify Commons, GPL-3.0</string>
    <string name="about_libraries">Mudita MMD, Jetpack Compose and AndroidX, Apache 2.0. The missed-call notification follows Android\'s own, Apache 2.0.</string>
    <string name="about_icons">Icons from Material Symbols, Apache 2.0</string>
    <string name="about_source_text">Source: github.com/wanderwildwood/itodenwa</string>
    <string name="about_feed_the_llamas">feed the llamas</string>
    <string name="about_no_browser">There is no browser on this phone to open that with.</string>


<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No internet: the call log and the contacts have no way off the phone through this app. -->

    <!-- Names for numbers, and the people to call. Read only: changing people is Contacts' job. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Recents. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Deleting a call from Recents, clearing them all, and marking missed calls seen. -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- The app's own ringer vibrates, for the few calls it rings itself. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Placing a call. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- The names of the SIMs, for a phone with two and no default. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- A ringing call comes up over the lock screen through its notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The panel goes off at the ear during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- Contacts, named when it is on the phone, for a person's card. -->
        <package android:name="com.wanderwildwood.enishi" />
        <!-- Notes, for a note about a call. -->
        <package android:name="com.wanderwildwood.oboegaki" />
        <!-- DuraSpeed, the Kompakt's background manager: only to say whether it is there. -->
        <package android:name="com.mediatek.duraspeed" />
        <!-- Other apps that can screen calls, to say so when one does in this app's place. -->
        <intent>
            <action android:name="android.telecom.CallScreeningService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT_OR_EDIT" />
            <data android:mimeType="vnd.android.cursor.item/contact" />
        </intent>
    </queries>

    <!-- Two labels. The drawer, the bar and the recent-apps list show the activity's, "Phone". Android's
         default-app chooser, App info and DuraSpeed's list show the application's, "Phone (itodenwa)",
         because Mudita's own dialer is called "Phone" there too, with the same handset, and two
         identical rows could not be told apart. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_label_full"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A keypad, from any app: with a number to dial, or empty. Being the phone app
                 needs both. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- "Show the call log". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/calls" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InCallActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.wanderwildwood.itodenwa.call"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- Every call, while this is the phone app. -->
        <service
            android:name=".call.CallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Asked about every call coming in, while this is the phone app: the block list and
             the rules in Settings. Bound only by the phone itself. -->
        <service
            android:name=".call.Screener"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".call.CallActions"
            android:exported="false" />

        <!-- The missed-call and voicemail notifications, handed over by the phone. Both are
             broadcasts only the system may send. -->
        <receiver
            android:name=".call.MissedCalls"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
                <action android:name="android.telephony.action.SHOW_VOICEMAIL_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
